{
    "name": "wtl/hio-typo3-connector-frontend",
    "description": "TYPO3 Connector for HISinOne (WTL Demo)",
    "type": "typo3-cms-extension",
    "license": [
        "GPL-2.0-or-later"
    ],
    "require": {
        "b13/container": "^3.1.10 || ^3.2.0",
        "typo3/cms-core": "^12.4 || ^13.0 || ^14.3",
        "typo3/cms-fluid-styled-content": "^12.4 || ^13.4 || ^14.3",
        "wtl/hio-typo3-connector": "^1.3.0"
    },
    "autoload": {
        "psr-4": {
            "Wtl\\HioTypo3ConnectorWtl\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "hio_typo3_connector_wtl"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "src/extensions/*"
        }
    ],
    "support": {
        "changelog": "https://github.com/wtl-public/hio-typo3-connector-frontend/blob/main/CHANGELOG.md"
    }
}
